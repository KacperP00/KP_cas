# Define locations
BINDIR = ../bin
MODDIR = ../mod
OBJDIR = ../obj


withMDUC = YES

ifeq ($(withMDUC),YES)

# The compiler
FC = mpiifort

# LINK MDUC LIBRARY
MDUC_DIR = /home/ad738098/codes/mduc
MDUC_INC = -I$(MDUC_DIR)/include
MDUC_LIB = -L$(MDUC_DIR)/lib -lmduc -lmduc_chem -lmduc_mechanism

# LINK SUNDIALS
SDIAL = /home/itv/compile_centos7/lib/sundials/2.7.0_intel19.0_intelmpi_2018_mkl/Install_DIR

# set up Sundials library
ifeq ($(strip $(SDIAL)),)
SDIAL = $(dir $(shell echo $$LD_LIBRARY_PATH | awk \
'BEGIN{FS=":"};{for(i=1;i<=NF;i++){if(match($$i,"sundials")){print $$i;exit;}}}'))
ifeq ($(strip $(SDIAL)),)
$(error no path to Sundials library detected)
else
$(warning using Sundials from $(SDIAL))
endif
endif
SDIAL_INC  := -I$(SDIAL)/include
SDIAL_LINK := -lsundials_cvode -lsundials_ida -lsundials_kinsol \
                   -lsundials_nvecserial
ifneq ($(findstring mpiifort,$(strip $(FC))),)
SDIAL_LINK += -lsundials_nvecparallel
endif
SDIAL_LIB := -L$(SDIAL)/lib $(SDIAL_LINK) -Wl,-rpath,$(SDIAL)/lib

INCFLAGS = $(MODDIR) $(MDUC_INC) $(SDIAL_INC)
LDFLAGS = -mkl -limf -lm $(MDUC_LIB) $(SDIAL_LIB)

MDUCFLAGS = -DMDUC_MPI -DMDUC -DSUNDIALS_FROM_2_7 -DAPPROXEXP3

else

FC = ifort

INCFLAGS = $(MODDIR)
LDFLAGS = -mkl -limf -lm

MDUCFLAGS = 

endif
# ======================================================================
# Let's start with the declarations
# ======================================================================

.SUFFIXES:
.SUFFIXES: .o .f90 .mod

# flags for debugging or for maximum performance, comment as necessary
DBGFLAGS = -g -fpp $(MDUCFLAGS) #-heap-arrays #-fbounds-check

OPTFLAGS = -O3 -fpp $(MDUCFLAGS) #-heap-arrays

DEBUG_OPTIONS = "FLAGS_ADD = $(DBGFLAGS)"
OPT_OPTIONS   = "FLAGS_ADD = $(OPTFLAGS)"

# flags forall (e.g. look for system .mod files, required in gfortran)
ICFLAGS  = -I $(MODDIR)

MODFLAGS = -module $(MODDIR)

OBJFLAGS = -J $(OBJDIR)

# libraries needed for linking, unused in the examples
#LDFLAGS = -li_need_this_lib

# List of executables to be built within the package
ALLDBG = cas cats carts
ALLOPT = cas_opt cats_opt carts_opt
CASDBG = cas
CASOPT = cas_opt
CATSDBG = cats
CATSOPT = cats_opt
CARTSDBG = carts
CARTSOPT = carts_opt

# objects
ifeq ($(withMDUC),YES)
CASF90FILES = precision.f90 math.f90 string.f90 \
      pc_defs.f90 pc_database.f90 pc_func.f90 combust_rif_mduc_defs.f90 combust_mduc.f90 \
      rk_defs.f90 solver_defs.f90 spray_defs.f90 parser.f90 rk_func.f90 solver_func.f90 spray_combust.f90 spray_func.f90 \
      cas.f90
else
CASF90FILES = precision.f90 math.f90 string.f90 \
      pc_defs.f90 pc_database.f90 pc_func.f90 \
      rk_defs.f90 solver_defs.f90 spray_defs.f90 parser.f90 rk_func.f90 solver_func.f90 spray_func.f90 \
      cas.f90
endif

# object files and module files 
CASOFILES = $(CASF90FILES:.f90=.o) $(CASCFILES:.c=.o)
CATSMODFILES = $(CASF90FILES:.f90=.mod)

# objects
CATSF90FILES = precision.f90 math.f90 string.f90 \
      pc_defs.f90 pc_database.f90 pc_func.f90 \
      rk_defs.f90 solver_defs.f90 spray_defs.f90 parser.f90 rk_func.f90 solver_func.f90 spray_func.f90 \
      cats.f90

# object files and module files 
CATSOFILES = $(CATSF90FILES:.f90=.o) $(CATSCFILES:.c=.o)
CATSMODFILES = $(CATSF90FILES:.f90=.mod)

# objects
ifeq ($(withMDUC),YES)
CARTSF90FILES = precision.f90 math.f90 string.f90 \
      pc_defs.f90 pc_database.f90 pc_func.f90 combust_rif_mduc_defs.f90 combust_mduc.f90 \
      rk_defs.f90 solver_defs.f90 spray_defs.f90 parser.f90 rk_func.f90 solver_func.f90 spray_combust.f90 spray_func.f90 \
      carts.f90

else
CARTSF90FILES = precision.f90 math.f90 string.f90 \
      pc_defs.f90 pc_database.f90 pc_func.f90 \
      rk_defs.f90 solver_defs.f90 spray_defs.f90 parser.f90 rk_func.f90 solver_func.f90 spray_func.f90 \
      carts.f90
endif

# object files and module files 
CARTSOFILES = $(CARTSF90FILES:.f90=.o) $(CARTSCFILES:.c=.o)
CARTSMODFILES = $(CARTSF90FILES:.f90=.mod)

##$(info $$OFILES is [${OFILES}])

default: all

all: alldebug
all_debug: alldebug
all_opt: allopt

cas: casdebug
cas_debug: casdebug
cas_opt: casopt

cats: catsdebug
cats_debug: catsdebug
cats_opt: catsopt

carts: cartsdebug
carts_debug: cartsdebug
carts_opt: cartsopt

alldebug:
	@$(MAKE) $(ALLDBG) $(DEBUG_OPTIONS)

allopt:
	@$(MAKE) $(ALLOPT) $(OPT_OPTIONS)

casdebug:
	@$(MAKE) $(CASDBG) $(DEBUG_OPTIONS)

casopt:
	@$(MAKE) $(CASOPT) $(OPT_OPTIONS)

$(CASOPT): $(CASOFILES)
	$(FC) $(FLAGS_ADD) -I$(INCFLAGS) $(OBJDIR)/*o $(LDFLAGS) -o $(BINDIR)/$(CASOPT) $(MODFLAGS)

$(CASDBG): $(CASOFILES)
	$(FC) $(FLAGS_ADD) -I$(INCFLAGS) $(OBJDIR)/*o $(LDFLAGS) -o $(BINDIR)/$(CASDBG) $(MODFLAGS)

catsdebug:
	@$(MAKE) $(CATSDBG) $(DEBUG_OPTIONS)

catsopt:
	@$(MAKE) $(CATSOPT) $(OPT_OPTIONS)

$(CATSOPT): $(CATSOFILES)
	$(FC) $(FLAGS_ADD) -I$(INCFLAGS) $(OBJDIR)/*o $(LDFLAGS) -o $(BINDIR)/$(CATSOPT) $(MODFLAGS)

$(CATSDBG): $(CATSOFILES)
	$(FC) $(FLAGS_ADD) -I$(INCFLAGS) $(OBJDIR)/*o $(LDFLAGS) -o $(BINDIR)/$(CATSDBG) $(MODFLAGS)

cartsdebug:
	@$(MAKE) $(CARTSDBG) $(DEBUG_OPTIONS)

cartsopt:
	@$(MAKE) $(CARTSOPT) $(OPT_OPTIONS)

$(CARTSOPT): $(CARTSOFILES)
	$(FC) $(FLAGS_ADD) -I$(INCFLAGS) $(OBJDIR)/*o $(LDFLAGS) -o $(BINDIR)/$(CARTSOPT) $(MODFLAGS)

$(CARTSDBG): $(CARTSOFILES)
	$(FC) $(FLAGS_ADD) -I$(INCFLAGS) $(OBJDIR)/*o $(LDFLAGS) -o $(BINDIR)/$(CARTSDBG) $(MODFLAGS)

$(CASOFILES): $(CASF90FILES)
	${FC} $(FLAGS_ADD) -c $*.f90 -o $(OBJDIR)/$@ $(MODFLAGS)
$(CATSOFILES): $(CATSF90FILES)
	${FC} $(FLAGS_ADD) -c $*.f90 -o $(OBJDIR)/$@ $(MODFLAGS)
$(CARTSOFILES): $(CARTSF90FILES)
	${FC} $(FLAGS_ADD) -c $*.f90 -o $(OBJDIR)/$@ $(MODFLAGS)

# Utility targets
.PHONY: clean veryclean

clean:
	cd $(MODDIR); rm -f *.mod
	cd $(OBJDIR); rm -f *.o
	rm -rf *.o *.mod

veryclean:
	cd $(MODDIR); rm -f *.mod
	cd $(OBJDIR); rm -f *.o
	cd $(BINDIR); rm -f $(CASOPT) $(CASDBG) $(CATSOPT) $(CATSDBG) $(CARTSOPT) $(CARTSDBG)
	rm -rf *.o *.mod
