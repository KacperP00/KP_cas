# Heptane mechanism from:
#   Liu, S., Hewson, J. C., Chen, J. H., Pitsch, H., "Effects on Strain Rate
#   on High-Pressure Nonpremixed N-Heptane Autoignition in Counterflow",
#   Comb. Flame 137 (2003) 320-339

# version from 04/30/02
# improved version of mbosaeshort
# mechanism compares very well with Pitz' mechanism 

let allowed atoms be C, H, O, N.
let additional species be N2.
let temperature exponent be n_k.
let order of reaction be n.
let units for A be [ cm^(3(n-1)) / ( s * mole^(n-1) * K^n_k ) ] .
let units for E be [ kJ / mole ].

#P      01.   H2-O2 React. (no HO2, H2O2)                                      
1f:   O2 + H           -> OH + O                { a = 2.000E+14  n = 0     E = 70.3 }
3f:   H2 + OH          -> H2O + H               { a = 1.000E+08  n = 1.6   E = 13.8 }
4f:   2 OH             -> H2O + O               { a = 1.500E+09  n = 1.14  E = 0.42 }

#P      02.   Recombination Reactions                                          
7f:   H + OH + M'      -> H2O + M'              { a = 2.200E+22  n = -2    E = 0 }

#P      03.   HO2 Formation/Consumption                                        
8:    H + O2 + M'      -> HO2 + M'              { a = 2.300E+18  n = -0.8  E = 0 }
9:    HO2 + H          -> OH + OH               { a = 1.500E+14  n = 0     E = 4.2 }
13:   HO2 + OH         -> H2O + O2              { a = 6.000E+13  n = 0     E = 0 }

#P      04.   HO2 Formation/Consumption                                        
14:   2 HO2            -> H2O2 + O2             { a = 2.500E+11  n = 0     E = -5.2 }
16f:  H2O2 + M'        -> OH + OH + M'          { a = 4.4244e+24 n = -2    E = 211.008 }

#P      05.   CO REACTIONS                                                     
17f:  CO + OH          -> CO2 + H               { a = 6.000E+06  n = 1.5   E = -3.1  }

#P      10.   CH Reactions                                                     
21:   CH + CO2         -> HCO + CO              { a = 3.400E+12  n = 0     E = 2.9 }
22:   CH + H2O         -> CH2OH                 { a = 5.700E+12  n = 0     E = -3.2  }

#P      11.   HCO REACTIONS                                                    
23:   HCO + M'         -> CO + H + M'           { a = 7.1000+14  n = 0     E = 70.3 }
23i:  HCO + H          -> CO + H2               { a = 9.000E+13  n = 0     E = 0 }
23ii: HCO + OH         -> CO + H2O              { a = 1.000E+14  n = 0     E = 0 }

#P      12.   CH2 Reactions                                                    
25:   3-CH2 + H        -> CH + H2               { a = 6.000E+12  n = 0     E = -7.5  }
28:   3-CH2 + O2       -> CO + OH + H           { a = 1.300E+13  n = 0     E = 6.2 }
32:   3-CH2 + H2       -> CH3 + H               { a = 7.200E+13  n = 0     E = 0 }

#P      13.   CH2O Reactions                                                   
36:   CH2O + OH        -> HCO + H2O             { a = 3.400E+09  n = 1.2   E = -1.9  }

#P      14.   CH3 Reactions                                                    
38:   CH3 + O          -> CH2O + H              { a = 8.430E+13  n = 0     E = 0 }
38i:  CH3 + O2         -> CH2O + OH             { a = 3.300E+11  n = 0     E = 37.4  }
38ii: CH3 + HO2        -> CH3O + OH             { a = 1.800E+13  n = 0     E = 0 }
39:   CH3 + H          -> CH4                   { a = 6.257E+23  n  = -1.8 E = 0 
                                                 ai = 2.108E+14  ni = 0   Ei = 0 
                                                 fca = 0.577000 fcta = 2370.00 }
45f:  CH3 + CH3        -> C2H6                  { a = 1.272E+41  n = -7    E = 11.56 
                                                 ai = 1.813E+13  ni = 0    Ei = 0 
                                                 fca = 0.380000 fcta = 73.0000  
                                                 fcb = 0.620000 fctb = 1180.00 }

#P      15a.   CH3O Reactions                                                  
46:   CH3O + M'        -> CH2O + H + M'         { a = 5.000E+13  n = 0     E = 105 }

#P      15b.   CH2OH Reactions                                                 
49:   CH2OH + M'       -> CH2O + H + M'         { a = 5.000E+13  n = 0     E = 105 }

#P      17.   CH4 Reactions                                                    
53:   CH4 + OH         -> H2O + CH3             { a = 1.600E+07  n = 1.83  E = 11.6  }

#P     21.    C2H2 REACTIONS                                          
57:   C2H2 + O        -> 3-CH2 + CO             { a = 1.720E+04  n = 2.8   E = 2.1 }

#P     25.    C2H3 REACTIONS                                          
59:   C2H3            -> C2H2 + H               { a = 1.187E+42  n = -7.5  E = 190.4 
                                                 ai = 2.000E+14  ni = 0    Ei = 166.29 
                                                 fcc = 0.35 }
59i:  C2H3 + O2       -> C2H2 + HO2             { a = 1.210e+11  n = 0     E = 0 }
60:   C2H3 + O2       -> CH2O + HCO             { a = 5.420E+12  n = 0     E = 0 }

#P    23.    C2H4 REACTIONS                                          
62:   C2H4 + H        -> C2H3 + H2              { a = 1.700E+15  n = 0     E = 62.9  }
63:   C2H4 + OH       -> C2H3 + H2O             { a = 6.500E+13  n = 0     E = 24.9  }

#P     24.   C2H5 REACTIONS                                           
64:   C2H5            -> C2H4 + H               { a = 1.000E+16  n = 0     E = 126 
                                                 ai = 1.300E+13 ni = 0     Ei = 167 
                                                 fca = 1.0      fcta = 422.800 
                                                 fcc = 0.411000 fctc = 73.4000 }
66:   C2H5 + O2       -> C2H4 + HO2             { a = 1.100E+10  n = 0     E = -6.3  }

#P     25.   C2H6 REACTIONS                                           
67:   C2H6 + H        -> C2H5 + H2              { a = 1.400E+09  n = 1.5   E = 31.1  }

#P      34.   C3H6 Reactions                                                   
77:   C3H6 + OH       -> C2H5 + CH2O            { a = 7.900E+12  n = 0     E = 0 }

#P      35a.   n-C3H7 Reactions                                                
80:   N-C3H7          -> CH3 + C2H4             { a = 9.600E+13  n = 0     E = 129.8 }
81f:  N-C3H7          -> H + C3H6               { a = 1.250E+14  n = 0     E = 154.9 }
82:   N-C3H7 + O2     -> C3H6 + HO2             { a = 1.000E+12  n = 0     E = 20.9  }

#P      43.   P-C4H9 REACTIONS                                                 
85:   P-C4H9          -> C2H5 + C2H4            { a = 2.500E+13  n = 0     E = 120.6 }

#P      44.   1-C5H11 REACTIONS                                                 
86:   1-C5H11         -> C2H4 + N-C3H7          { a = 3.200E+13  n = 0     E = 118.9 }

#P    16.    C7H15 REACTIONS                                           
91:   1-C7H15         -> 1-C5H11 + C2H4         { a = 1.500E+13  n = 0     E = 120.6 }
92:   2-C7H15         -> P-C4H9 + C3H6          { a = 5.600E+13  n = 0     E = 118.5 }

#P      78.   N-C7H16 REACTIONS
96:   N-C7H16         -> P-C4H9  + N-C3H7       { a = 3.160E+16  n = 0     E = 339.2 }
97:   N-C7H16 + H     -> 1-C7H15 + H2           { a = 5.600E+07  n = 2     E = 32.2 }
98:   N-C7H16 + H     -> 2-C7H15 + H2           { a = 4.378E+07  n = 2     E = 20.9 }
99:   N-C7H16 + OH    -> 1-C7H15 + H2O          { a = 8.610E+09  n = 1.1   E = 7.6 }
100:  N-C7H16 + OH    -> 2-C7H15 + H2O          { a = 6.500E+09  n = 1.3   E = 2.9 }
101:  N-C7H16 + HO2   -> 1-C7H15 + H2O2         { a = 1.120E+13  n = 0     E = 81.2 }
102:  N-C7H16 + HO2   -> 2-C7H15 + H2O2         { a = 1.675E+13  n = 0     E = 71.2 }
103:  N-C7H16 + O2    -> 1-C7H15 + HO2          { a = 2.500E+13  n = 0     E = 205.2 }
104:  N-C7H16 + O2    -> 2-C7H15 + HO2          { a = 1.000E+14  n = 0     E = 199.3 }

# *****************************************
#   Low Temperature Branch simplified by UIC #
# *****************************************

## R -> C7H15; - means one H missing
## RO2        heptylperoxy radical ( C7H15O2     --- old mech -> 1C7H15O2-C7H15O2 )
## R'O2H      isomerization of RO2 ( C7H14OOH    --- old mech -> 1HEOOH-2-C7H15O2 )
## O2R'O2H    ???                  ( O2C7H14O2H  --- old mech -> 2OO7OOH1-O2C7H15O2 )
## HO2R''O2H  ???                  ( HO2C7H13OOH --- old mech -> 1-2HEOOH-O2C7H14OOH )
## OR''O2H    ketoheptylperoxide   ( OC7H13OOH   --- old mech -> OC7OOH-OC7H13OOH )
## OR''O      ????                 ( OC7H13O     --- old mech -> 1-2HEPOO-OC7H13O )

# different from SAE: backward reactions of first O2 addition changed from 1.4e15 to 1.75e15
105f: 1-C7H15 + O2    -> C7H15O2                { a = 2.000E+12  n = 0     E = 0 }
105b: C7H15O2         -> 1-C7H15 + O2           { a = 3.000E+14  n = 0     E = 117.3 }
106f: 2-C7H15 + O2    -> C7H15O2                { a = 2.000E+12  n = 0     E = 0 }
106b: C7H15O2         -> 2-C7H15 + O2           { a = 6.600E+14  n = 0     E = 117.3 }
107f: C7H15O2         -> C7H14OOH               { a = 2.000E+11  n = 0     E = 71.2  }
107b: C7H14OOH        -> C7H15O2                { a = 1.000E+11  n = 0     E = 52.3  }
108:  C7H14OOH + O2   -> O2C7H14O2H             { a = 5.000E+11  n = 0     E = 0  }
109:  O2C7H14O2H      -> HO2C7H13OOH            { a = 2.000E+11  n = 0     E = 71.2  }
110:  HO2C7H13OOH     -> OC7H13OOH + OH         { a = 1.000E+09  n = 0     E = 31.4  }
111:  OC7H13OOH       -> OC7H13O + OH           { a = 8.400E+14  n = 0     E = 180.1 }
112:  OC7H13O         -> CH2O + 1-C5H11 + CO    { a = 2.000E+13  n = 0     E = 62.8 }

let [M'] =   3.00 [N-C7H16] + 1.00 [H2] + 0.75 [CO] + 0.40 [N2] + 6.50 [H2O] + 0.40 [O2].
