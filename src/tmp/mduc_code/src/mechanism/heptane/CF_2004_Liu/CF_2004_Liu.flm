# Heptane mechanism from:
#   Liu, S., Hewson, J. C., Chen, J. H., Pitsch, H., "Effects on Strain Rate
#   on High-Pressure Nonpremixed N-Heptane Autoignition in Counterflow",
#   Comb. Flame 137 (2003) 320-339

# version from 04/30/02
# improved version of mbosaeshort
# mechanism compares very well with Pitz' mechanism 

let allowed atoms be C, H, O, N.
let additional species be N2.
let temperature exponent be n_k.
let order of reaction be n.
let units for A be [ cm^(3(n-1)) / ( s * mole^(n-1) * K^n_k ) ] .
let units for E be [ kJ / mole ].

#P      01.   H2-O2 React. (no HO2, H2O2)                                      
1f:   O2 + H           -> OH + O                { a = 2.000E+14  n = 0     E = 70.3 }
2f:   H2 + O           -> OH + H                { a = 5.060E+04  n = 2.67  E = 26.3 }
3f:   H2 + OH          -> H2O + H               { a = 1.000E+08  n = 1.6   E = 13.8 }
4f:   2 OH             -> H2O + O               { a = 1.500E+09  n = 1.14  E = 0.42 }

#P      02.   Recombination Reactions                                          
5f:   2 H + M'         -> H2 + M'               { a = 1.800E+18  n = -1    E = 0 }
6f:   2 O + M'         -> O2 + M'               { a = 2.900E+17  n = -1    E = 0 }
7f:   H + OH + M'      -> H2O + M'              { a = 2.200E+22  n = -2    E = 0 }

#P      03.   HO2 Formation/Consumption                                        
8f:   H + O2 + M'      -> HO2 + M'              { a = 2.300E+18  n = -0.8  E = 0 }
9f:   HO2 + H          -> OH + OH               { a = 1.500E+14  n = 0     E = 4.2 }
10f:  HO2 + H          -> H2 + O2               { a = 2.500E+13  n = 0     E = 2.9 }
11f:  HO2 + H          -> H2O + O               { a = 3.000E+13  n = 0     E = 7.2 }
12f:  HO2 + O          -> OH + O2               { a = 1.800E+13  n = 0     E = -1.7 }
13f:  HO2 + OH         -> H2O + O2              { a = 6.000E+13  n = 0     E = 0 }

#P      04.   HO2 Formation/Consumption                                        
14f:  2 HO2            -> H2O2 + O2             { a = 2.500E+11  n = 0     E = -5.2 }
15f:  2 OH + M'        -> H2O2 + M'             { a = 3.250E+22  n = -2    E = 0 }
16f:  H2O2 + OH        -> H2O + HO2             { a = 5.400E+12  n = 0     E = 4.2 }

#P      05.   CO REACTIONS                                                     
17f:  CO + OH          -> CO2 + H               { a = 6.000E+06  n = 1.5   E = -3.1  }
18f:  CO + HO2         -> CO2 + OH              { a = 1.500E+14  n = 0     E = 98.7  }
19f:  CO + O + M'      -> CO2 + M'              { a = 7.100E+13  n = 0     E = -19 }

#P      10.   CH Reactions                                                     
20:   CH + O2          -> HCO + O               { a = 6.000E+13  n = 0     E = 0 }
21:   CH + CO2         -> HCO + CO              { a = 3.400E+12  n = 0     E = 2.9 }
22f:  CH + H2O         -> CH2OH                 { a = 5.700E+12  n = 0     E = -3.2  }

#P      11.   HCO REACTIONS                                                    
23f:  HCO + M'         -> CO + H + M'           { a = 1.566E+14  n = 0     E = 65.93 }
### reaction HCO + O2 -> CO + HO2 very important for very high temperature
24f:  HCO + O2         -> CO + HO2              { a = 3.000E+12  n = 0 E = 0 }

#P      12.   CH2 Reactions                                                    
25f:  3-CH2 + H        -> CH + H2               { a = 6.000E+12  n = 0     E = -7.5  }
# different from SAE
26f:  3-CH2 + 3-CH2    -> C2H2 + H2             { a = 1.200E+13  n = 0     E = 3.4 }
27f:  3-CH2 + CH3      -> C2H4 + H              { a = 4.200E+13  n = 0     E = 0 }
28f:  3-CH2 + O2       -> CO + OH + H           { a = 1.300E+13  n = 0     E = 6.2 }
29f:  3-CH2 + O2       -> CO2 + H2              { a = 1.200E+13  n = 0     E = 6.2 }
30f:  1-CH2 + M'       -> 3-CH2 + M'            { a = 1.200E+13  n = 0     E = 0 }
31f:  1-CH2 + O2       -> CO + OH + H           { a = 3.100E+13  n = 0     E = 0 }
32f:  1-CH2 + H2       -> CH3 + H               { a = 7.200E+13  n = 0     E = 0 }

#P      13.   CH2O Reactions                                                   
33f:  CH2O + M'        -> HCO + H + M'          { a = 5.000E+16  n = 0     E = 320 }
34f:  CH2O + H         -> HCO + H2              { a = 2.300E+10  n = 1.05  E = 13.7  }
# in addition to SAE
35f:  CH2O + O         -> HCO + OH              { a = 4.150E+11  n = 0.57  E = 11.6  }
36f:  CH2O + OH        -> HCO + H2O             { a = 3.400E+09  n = 1.2   E = -1.9  }
### reaction CH2O + HO2       -> HCO + H2O2 important for high temperature
# high sensitivity to CO in lean PFR, but not for C2H4
37f:  CH2O + HO2       -> HCO + H2O2            { a = 3.000E+12  n = 0     E = 54.7  }

#P      14.   CH3 Reactions                                                    
38f:  CH3 + O          -> CH2O + H              { a = 8.430E+13  n = 0     E = 0 }
39f:  CH3 + H          -> CH4                   { a = 6.257E+23  n  = -1.8 E = 0 
                                                 ai = 2.108E+14  ni = 0   Ei = 0 
                                                 fca = 0.577000 fcta = 2370.00 }
40:   CH3 + OH         -> CH3O + H              { a = 2.260E+14  n = 0     E = 64.8  }
41:   CH3 + O2         -> CH2O + OH             { a = 3.300E+11  n = 0     E = 37.4  }
# in addition to SAE
42f:  CH3 + HO2        -> CH3O + OH             { a = 1.800E+13  n = 0     E = 0 }
# in addition to SAE
43f:  CH3 + HO2        -> CH4 + O2              { a = 3.600E+12  n = 0     E = 0 }
44:   CH3 + CH3        -> C2H4 + H2             { a = 1.000E+16  n = 0     E = 134 }
45f:  CH3 + CH3        -> C2H6                  { a = 1.272E+41  n = -7    E = 11.56 
                                                 ai = 1.813E+13  ni = 0    Ei = 0 
                                                 fca = 0.380000 fcta = 73.0000  
                                                 fcb = 0.620000 fctb = 1180.00 }

#P      15a.   CH3O Reactions                                                  
46f:  CH3O + M'        -> CH2O + H + M'         { a = 5.000E+13  n = 0     E = 105 }
47f:  CH3O + H         -> CH2O + H2             { a = 1.800E+13  n = 0     E = 0 }
# in addition to SAE
48f:  CH3O + O2        -> CH2O + HO2            { a = 4.000E+10  n = 0     E = 8.9 }

#P      15b.   CH2OH Reactions                                                 
49f:  CH2OH + M'       -> CH2O + H + M'         { a = 5.000E+13  n = 0     E = 105 }
50f:  CH2OH + H        -> CH2O + H2             { a = 3.000E+13  n = 0     E = 0 }
51f:  CH2OH + O2       -> CH2O + HO2            { a = 1.000E+13  n = 0     E = 30  }

#P      17.   CH4 Reactions                                                    
52f:  CH4 + H          -> H2 + CH3              { a = 1.300E+04  n = 3     E = 33.6  }
53f:  CH4 + OH         -> H2O + CH3             { a = 1.600E+07  n = 1.83  E = 11.6  }

#P     20A.    HCCO REACTIONS                                         
54f:  HCCO + H        -> 3-CH2 + CO             { a = 1.500E+14  n = 0     E = 0 }
55:   HCCO + O        -> CO + CO + H            { a = 9.600E+13  n = 0     E = 0 }

#P     21.    C2H2 REACTIONS                                          
56f:  C2H2 + O2       -> HCCO + OH              { a = 2.000E+08  n = 1.5   E = 126 }
57f:  C2H2 + O        -> 3-CH2 + CO             { a = 1.720E+04  n = 2.8   E = 2.1 }
58f:  C2H2 + O        -> HCCO + H               { a = 1.720E+04  n = 2.8   E = 2.1 }

#P     25.    C2H3 REACTIONS                                          
59f:  C2H3            -> C2H2 + H               { a = 1.187E+42  n = -7.5  E = 190.4 
                                                 ai = 2.000E+14  ni = 0    Ei = 166.29 
                                                 fcc = 0.35 }
60:   C2H3 + O2       -> CH2O + HCO             { a = 5.420E+12  n = 0     E = 0 }

#P    23.    C2H4 REACTIONS                                          
61f:  C2H4 + M'       -> C2H2 + H2 + M'         { a = 2.500E+17  n = 0     E = 319.8 }
62f:  C2H4 + H        -> C2H3 + H2              { a = 1.700E+15  n = 0     E = 62.9  }
# changed from 2.05e13 to 6.500E+13
# setting to original value tig too high for phi=1,2 in high temp regime
# setting to even higher does not change anything
63f:  C2H4 + OH       -> C2H3 + H2O             { a = 6.500E+13  n = 0     E = 24.9  }

#P     24.   C2H5 REACTIONS                                           
64f:  C2H5            -> C2H4 + H               { a = 1.000E+16  n = 0     E = 126 
                                                 ai = 1.300E+13 ni = 0     Ei = 167 
                                                 fca = 1.0      fcta = 422.800 
                                                 fcc = 0.411000 fctc = 73.4000 }
65f:  C2H5 + H        -> 2 CH3                  { a = 3.000E+13  n = 0     E = 0 }
66f:  C2H5 + O2       -> C2H4 + HO2             { a = 1.100E+10  n = 0     E = -6.3  }

#P     25.   C2H6 REACTIONS                                           
67:   C2H6 + H        -> C2H5 + H2              { a = 1.400E+09  n = 1.5   E = 31.1  }
68:   C2H6 + OH       -> C2H5 + H2O             { a = 7.200E+06  n = 2     E = 3.6 }
69:   C2H6 + CH3      -> C2H5 + CH4             { a = 1.500E-07  n = 6     E = 25.4  }

#P      31.   C3H3 Reactions                                                   

#P      32.   C3H4 Reactions                                                   
70:   C3H4 + OH       -> CH2O + C2H3            { a = 1.000E+12  n = 0     E = 0 }
71:   C3H4 + OH       -> HCO + C2H4             { a = 1.000E+12  n = 0     E = 0 }

#P      33.   C3H5 Reactions                                                   
72f:  C3H5            -> C3H4 + H               { a = 3.980E+13  n = 0     E = 293.1 }
# following reaction changed from 1.0e13 to 0.5e12. This improves rich PSR and leaves lean PSR and ign del unchanged
73f:  C3H5 + H        -> C3H4 + H2              { a = 0.500E+13  n = 0     E = 0 }
74f:  C3H5 + O2       -> C3H4 + HO2             { a = 6.000E+11  n = 0     E = 41.9  }

#P      34.   C3H6 Reactions                                                   
75f:  C3H6            -> C2H3 + CH3             { a = 3.150E+15  n = 0     E = 359 }
76f:  C3H6 + H        -> C3H5 + H2              { a = 5.000E+12  n = 0     E = 6.3 }
# in addition to SAE
# increasing does not really change CO in lean PSR
77f:  C3H6 + OH       -> C2H5 + CH2O            { a = 7.900E+12  n = 0     E = 0 }
# in addition to SAE
78f:  C3H6 + OH       -> C3H5 + H2O             { a = 4.000E+12  n = 0     E = 0 }
# rate following tsang to products path 1991
79:   C3H6 + CH3        -> C3H5 + CH4           { a = 8.960E+12  n = 0     E = 35.6  }

#P      35a.   n-C3H7 Reactions                                                
80f:  N-C3H7          -> CH3 + C2H4             { a = 9.600E+13  n = 0     E = 129.8 }
81f:  N-C3H7          -> H + C3H6               { a = 1.250E+14  n = 0     E = 154.9 }
82f:  N-C3H7 + O2     -> C3H6 + HO2             { a = 1.000E+12  n = 0     E = 20.9  }

#P      42.   1-C4H8 REACTIONS                                                 
# in addition to SAE
83f:  1-C4H8          -> C3H5 + CH3             { a = 8.000E+16  n = 0     E = 307.4 }
84f:  1-C4H8 + OH     -> N-C3H7 + CH2O          { a = 6.500E+12  n = 0     E = 0 }

#P      43.   P-C4H9 REACTIONS                                                 
85:   P-C4H9          -> C2H5 + C2H4            { a = 2.500E+13  n = 0     E = 120.6 }

#P      44.   1-C5H11 REACTIONS                                                 
86:   1-C5H11         -> C2H4 + N-C3H7          { a = 3.200E+13  n = 0     E = 118.9 }

#P      6.1 C6H11 Consumption
# in addition to SAE
87:   C6H11           -> C3H5 + C3H6            { a = 2.500E+13  n = 0     E = 125.6 }

#P      6.2 C6H12 Consumption
# in addition to SAE
88:   1-C6H12         -> N-C3H7 + C3H5          { a = 2.500E+16  n = 0     E = 297.7 }
