103:  N-C7H16 + O2    -> 1-C7H15 + HO2          { a = 5.500E+13  n = 0     E = 205.2 }
104:  N-C7H16 + O2    -> 2-C7H15 + HO2          { a = 8.000E+13  n = 0     E = 199.3 }

# *****************************************
#   Low Temperature Branch simplified by UIC #
# *****************************************

## R -> C7H15; - means one H missing
## RO2        heptylperoxy radical ( C7H15O2     --- old mech -> 1C7H15O2-C7H15O2 )
## R'O2H      isomerization of RO2 ( C7H14OOH    --- old mech -> 1HEOOH-2-C7H15O2 )
## O2R'O2H    ???                  ( O2C7H14O2H  --- old mech -> 2OO7OOH1-O2C7H15O2 )
## HO2R''O2H  ???                  ( HO2C7H13OOH --- old mech -> 1-2HEOOH-O2C7H14OOH )
## OR''O2H    ketoheptylperoxide   ( OC7H13OOH   --- old mech -> OC7OOH-OC7H13OOH )
## OR''O      ????                 ( OC7H13O     --- old mech -> 1-2HEPOO-OC7H13O )

# different from SAE: backward reactions of first O2 addition changed from 1.4e15 to 1.75e15
105f: 1-C7H15 + O2    -> C7H15O2                { a = 2.000E+12  n = 0     E = 0 }
105b: C7H15O2         -> 1-C7H15 + O2           { a = 1.750E+15  n = 0     E = 117.3 }
106f: 2-C7H15 + O2    -> C7H15O2                { a = 2.000E+12  n = 0     E = 0 }
106b: C7H15O2         -> 2-C7H15 + O2           { a = 1.750E+15  n = 0     E = 117.3 }
107:  C7H15O2         -> C7H14OOH               { a = 6.000E+11  n = 0     E = 85.6  }
108:  C7H14OOH + O2   -> O2C7H14O2H             { a = 5.000E+11  n = 0     E = 0  }
109:  O2C7H14O2H      -> HO2C7H13OOH            { a = 2.000E+11  n = 0     E = 71.2  }
110:  HO2C7H13OOH     -> OC7H13OOH + OH         { a = 1.000E+09  n = 0     E = 31.4  }
111:  OC7H13OOH       -> OC7H13O + OH           { a = 8.400E+14  n = 0     E = 180.1 }
112:  OC7H13O         -> CH2O + 1-C5H11 + CO    { a = 2.000E+13  n = 0     E = 62.8 }

let [M'] =   3.00 [N-C7H16] + 1.00 [H2] + 0.75 [CO] + 0.40 [N2] + 6.50 [H2O] + 0.40 [O2].
