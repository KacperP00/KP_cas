94:   1-C7H15         -> 2-C7H15                { a = 2.000E+11  n = 0     E = 75.8  }
95:   2-C7H15         -> 1-C7H15                { a = 3.000E+11  n = 0     E = 88.4  }

#P      78.   N-C7H16 REACTIONS
96:   N-C7H16         -> P-C4H9 + N-C3H7        { a = 3.160E+16  n = 0     E = 339.2 }
