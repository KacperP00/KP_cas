# ionh skeletal plus skeletal princeton toluene mechanism, skeletal eth and hai
# delivered to GM on December 31, 2003
# soot part taken from nHeptane.RifSootNO4Ref.mech, which is the same as nHeptane.RifSootNO4.mech,
# but with short PAH and no soot reactions

let allowed atoms be  h, c, o, n, ar.
let additional species be N2, AR, C6H5CH3.
let temperature exponent be n_k.
let order of reaction be n.
let units for A be [ cm^(3(n-1)) / ( s * mole^(n-1) * K^n_k ) ].
let units for E be [ kJ / mole ].

