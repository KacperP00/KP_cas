# Compiler flags
CFLAGS   = 
F90FLAGS = 
F77FLAGS =
LDFLAGS  = 
INCFLAGS = 
DBGFLAGS = -g -O0
OPTFLAGS = -O3 -xSSE4.2 -ip -g
SOFLAGS  = -fPIC -shared -g
