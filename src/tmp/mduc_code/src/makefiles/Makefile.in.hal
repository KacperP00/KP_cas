# compile options
PARALLEL=
#CHEMMECH  = heptanesymp
#CHEMMECH  = nHeptane.ecfm3z
CHEMMECH  = nHeptane.allstar
#CHEMMECH  = BaseplusMCH
#CHEMMECH  = ionhtol.pollutantsnoxGRI
#CHEMMECH = Spec_57_Reac_304
#CHEMMECH  = nHeptane.shortNOx
#CHEMMECH = NC7_LT
#CHEMMECH = propane_gri211
#CHEMMECH = PRF_LT
# don't use this #CHEMMECH  = nHeptane.allstarnew_oksred25
MDUC_ACCESS = #MDUC_JBETA_ADAPT SUNDIALS_2_3 #MDUC_PDF_LM 
ifdef PARALLEL
	MDUC_ACCESS += ACCESS_MPI
endif

#MPI_DIR=/gpfs3/applications/ansys/13.0/v130/ansys/hpmpi/linx64
MPI_DIR=/gpfs3/applications/ansys/14.0/v140/commonfiles/MPI/Platform/8.1.2/linx64
#MPI_DIR=/software/AVL/HPMPI/v2.3/x86_64-unknown-linux
#MPI_DIR=/software/intel/mpi/4.0
#MPI_DIR=/software/openmpi/1.4.3/intel/11.1
MPI_BIN=${MPI_DIR}/bin
MPI_LIB=-L${MPI_DIR}/bin
MPI_INC=-I${MPI_DIR}/include

# Compiler and archiver
ifdef PARALLEL
  CC = ${MPI_BIN}/mpicc
  LD = ${MPI_BIN}/mpicc
#  CC = mpicc
#  LD = mpicc
else
  CC = gcc
  LD = gcc
endif
AR  = ar rcv
RL  = ranlib

# External libraries
#= /gpfs3/applications/sundials/2.4.0/intel/11.1
SDIAL  = /gpfs3/applications/sundials/2.4.0/gnu/4.1.2

# Compiler flags
CFLAGS   =
LDFLAGS  = 
INCFLAGS = 
DBGFLAGS = -g -O0
OPTFLAGS = -O3 -xSSE4.2 -ip -g
SOFLAGS  = -fPIC -shared -g

ifdef PARALLEL
  LDFLAGS += ${MPI_LIB}
endif
