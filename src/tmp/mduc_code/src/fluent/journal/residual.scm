; Making Fluent write the residuals to the file
(define my-residuals-file (format #f "~a/monitor/residuals.dat" case-dir))
(display (format #f "\nMy residuals file is ~a\n" my-residuals-file))
(define port) 
(set! port (open-output-file my-residuals-file))
(do ((i 0 (+ i 1)))
         ((= i (length (solver-residuals))))
           (format port "\#~a ~2t" (car (list-ref (solver-residuals)i))) )
      (newline port)
(define my_run_res
  (lambda ()
      (do ((i 0 (+ i 1)))
     ((= i (length (solver-residuals))))
         (format port "~a ~2t" (cdr (list-ref (solver-residuals)i))) )
    (newline port)
 )
)
(ti-menu-load-string "/solve/execute-commands/add-edit my_res_out 1 \"iteration\" \"(my_run_res())\"")